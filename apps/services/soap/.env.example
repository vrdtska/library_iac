# Credenciales de PostgreSQL (ver apps/db/00_create_database.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=library_user
DB_PASSWORD=cambia_esta_password

# Puerto del microservicio de libros (lo consume la app Electron)
FLASK_PORT=5001
FLASK_DEBUG=false

# Moneda del atributo price del XML
CURRENCY=USD

# Paginado por defecto del catalogo
DEFAULT_LIMIT=8
MAX_LIMIT=100

# Carpeta de imagenes servida en /uploads/<archivo> (vacia = ruta por defecto)
UPLOADS_DIR=
