# Credenciales de PostgreSQL (ver apps/db/00_create_database.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=library_user
DB_PASSWORD=library666

# Clave de firma de las sesiones de Flask.
# Genera una nueva con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=pon_aqui_secrets_token_hex_32

# Puerto del microservicio de autenticacion
FLASK_PORT=5000
FLASK_DEBUG=false

# Rol asignado a los usuarios que se registran por si mismos
DEFAULT_ROLE_NAME=Usuario Registrado
MIN_PASSWORD_LENGTH=8

# Verificacion de correo:
#   false -> el registro deja la cuenta verificada (flujo registro -> login directo)
#   true  -> /login responde 403 hasta pasar por /verify-email/<token>
REQUIRE_EMAIL_VERIFICATION=false
# Poner true para enviar el correo con la API de SendGrid (requiere SENDGRID_API_KEY)
SEND_VERIFICATION_EMAIL=false
MAIL_FROM=no-reply@tudominio.com
# Pega aqui tu clave real de SendGrid; NUNCA subas el archivo .env al repositorio.
SENDGRID_API_KEY=
