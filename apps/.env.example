# Plantilla de variables de entorno (copiar a .env y completar).
# NUNCA subas el archivo .env real al repositorio.

# --- PostgreSQL (ver apps/db/00_create_database.sql) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=library_user
DB_PASSWORD=cambia_esta_password

# --- Flask ---
SECRET_KEY=pon_aqui_secrets_token_hex_32
FLASK_DEBUG=false

# --- Microservicio de libros (apps/services/soap) ---
FLASK_PORT=5001
CURRENCY=USD
DEFAULT_LIMIT=8
MAX_LIMIT=100
UPLOADS_DIR=

# --- Microservicio de autenticacion (apps/services/login) ---
FLASK_PORT_LOGIN=5000
DEFAULT_ROLE_NAME=Usuario Registrado
MIN_PASSWORD_LENGTH=8
REQUIRE_EMAIL_VERIFICATION=false
SEND_VERIFICATION_EMAIL=false
MAIL_FROM=no-reply@tudominio.com
# --- JWT (emision en login / verificacion local en libros) ---
# MISMO valor en apps/services/login/.env y apps/services/soap/.env:
# el servicio de libros valida la firma en memoria, sin llamar al login.
JWT_SECRET_KEY=pon_aqui_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_SECONDS=1200
JWT_REFRESH_SECONDS=86400
# Roles admitidos para escribir en libros (vacio = cualquier autenticado)
JWT_WRITE_ROLES=
# --- Redis (capa compartida: sesiones, refresh, revocacion, cache) ---
# URL comun a los 6 microservicios (login, books, users, authors, pedidos, pagos).
REDIS_URL=redis://:tu_password@localhost:6379/0
REDIS_CONNECT_TIMEOUT=2
REDIS_TIMEOUT=2
# Lecturas cacheadas: fail-open. Sesion/revocacion/autorizacion: fail-closed.
BOOKS_CACHE_LIST_TTL=60
BOOKS_CACHE_ITEM_TTL=120
# --- CORS (solo origenes cliente en produccion) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
SENDGRID_API_KEY=
